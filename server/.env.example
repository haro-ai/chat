# Localhost bind — published to the tailnet via `tailscale serve`.
HARO_HOST=127.0.0.1
HARO_PORT=8787

# pi binary + how to invoke it (`--mode rpc` and trust args are appended).
HARO_PI_BIN=pi
# Pi children run here — the same directory your SSH .bashrc drops you into,
# so phone sessions live in the same session store as TUI ones (Model A).
HARO_CWD=
# Pi's session store, scanned to list past sessions.
HARO_SESSIONS_DIR=

# Extra args for every pi child (space-split). `--approve` trusts the working
# folder's project-local files — children are non-interactive and would
# otherwise deadlock on a TUI-only trust prompt.
HARO_PI_ARGS=--approve

# Idle window before a conversation's pi child is recycled; LRU cap.
HARO_IDLE_TIMEOUT_MS=600000
HARO_MAX_CHILDREN=4
