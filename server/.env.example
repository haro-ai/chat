# haro chat service — runtime config (see src/config.ts)
# Binds localhost; publish via `tailscale serve` (ARCHITECTURE.md §1).
HARO_HOST=127.0.0.1
HARO_PORT=8787
HARO_PI_BIN=pi
# Transient scratch root — must stay inside tmpfs-style temp space (R5).
HARO_SCRATCH_ROOT=/tmp/haro-chat-scratch
HARO_IDLE_TIMEOUT_MS=600000
HARO_MAX_CHILDREN=4
